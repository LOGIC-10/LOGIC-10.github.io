---
import Layout from '../layouts/Layout.astro';
import { profile, socialLinks } from '../data/profile';
---
<Layout title="About" description={`Qinyu Luo at ${profile.affiliation}: research interests, academic background, and contact information.`} active="about">
  <div class="container about-page">
    <header class="page-heading about-heading"><p class="eyebrow">A little about me</p><h1 class="page-title">Curiosity, with<br /><em>something to build.</em></h1></header>
    <div class="about-intro"><div class="about-photo"><img src="/images/portrait.jpg" alt="Qinyu Luo" width="1537" height="1537" fetchpriority="high" /><span>Qinyu Luo <span>Researcher & builder</span></span></div><div class="about-copy"><p class="intro-line">I’m Qinyu Luo, currently with <a href={profile.affiliationUrl} target="_blank" rel="noopener noreferrer">{profile.affiliation}</a>. I’m interested in language models that can reason, use tools, and work with one another.</p><p>My work centers on LLM-driven agents, multi-agent systems, agentic tool learning, and multimodal reasoning. I’m especially interested in what happens when these ideas meet the details of a real task.</p><p>My academic background includes research with <a href="https://nlp.csai.tsinghua.edu.cn/" target="_blank" rel="noopener noreferrer">THUNLP at Tsinghua University</a> and graduate study at <a href="https://www.jhu.edu/" target="_blank" rel="noopener noreferrer">Johns Hopkins University</a>. My projects span repository-level documentation, open-source language models, and a wireless stethoscope prototype.</p></div></div>

    <div class="about-details"><section aria-labelledby="background-title"><div class="about-section-heading"><span>01</span><h2 id="background-title">Experience & background</h2></div><div class="background-entry current-affiliation"><p class="entry-date">Current</p><h3><a href={profile.affiliationUrl} target="_blank" rel="noopener noreferrer">{profile.affiliation}</a></h3></div><div class="background-entry"><p class="entry-date">2024.09 — 2026.05</p><h3>Johns Hopkins University</h3><p>Graduate study in Engineering Management,<br />Computer Science track.</p></div><div class="background-entry"><p class="entry-date">Research experience</p><h3>Tsinghua University · THUNLP</h3><p>Research on large language models<br />and agent systems.</p></div></section><section aria-labelledby="interests-title"><div class="about-section-heading"><span>02</span><h2 id="interests-title">Questions that interest me</h2></div><ul class="interest-list"><li><span>01</span><div><h3>Agents that get things done</h3><p>Reasoning, planning, and using tools across a complete task.</p></div></li><li><span>02</span><div><h3>Working together</h3><p>How multiple agents coordinate and share useful context.</p></div></li><li><span>03</span><div><h3>From research to useful tools</h3><p>Developer tools, multimodal systems, and intelligent healthcare.</p></div></li></ul></section></div>

    <section class="beyond-research" aria-labelledby="beyond-title"><p class="eyebrow">Beyond the paper</p><h2 id="beyond-title">Make it. Share it. Keep learning.</h2><div><p>I enjoy sharing practical experience and working through ideas in public. That has taken the form of open-source contributions, paper notes, and talks about language models and agents.</p><a href="/notes/">Read my notes & talks <span aria-hidden="true">↗</span></a></div></section>

    <section class="contact-section" id="get-in-touch" aria-labelledby="contact-title"><div><p class="eyebrow">Say hello</p><h2 id="contact-title">Good work starts<br />with a conversation.</h2><p>I’m happy to connect with people thinking about agents, language models, and intelligent healthcare.</p></div><div class="contact-links"><a class="email-link" href={`mailto:${profile.email}`} data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog">{profile.email} <span aria-hidden="true">↗</span></a>{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div></section>
  </div>
</Layout>
<style>
  .about-page{padding-bottom:6rem}.about-heading em{font-weight:400;color:var(--accent,#b34d38)}.about-intro{display:grid;grid-template-columns:300px 1fr;gap:6rem;align-items:start;margin-top:3.5rem}.about-photo{position:relative}.about-photo img{display:block;width:100%;height:360px;object-fit:cover;object-position:center 30%;filter:saturate(.8)}.about-photo>span{display:flex;align-items:baseline;justify-content:space-between;font-size:.68rem;color:var(--muted,#73736a);padding-top:1rem;border-bottom:1px solid var(--line,#deddd5);padding-bottom:1rem}.about-photo>span>span{font-size:.7rem;letter-spacing:.1em}.about-copy{padding-top:.3rem}.about-copy p{font-size:.95rem;line-height:1.9;color:var(--muted,#73736a);margin:0 0 1.25rem}.about-copy .intro-line{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:1.9rem;letter-spacing:-.02em;line-height:1.45;color:inherit;margin-bottom:1.5rem}.about-copy p a{color:inherit;text-decoration-color:#c2bbae;text-underline-offset:.2em}.about-copy p a:hover{color:var(--accent,#b34d38)}.about-details{display:grid;grid-template-columns:1fr 1fr;gap:6rem;border-top:1px solid var(--line,#deddd5);margin-top:5rem;padding-top:2.4rem}.about-section-heading{display:flex;align-items:baseline;gap:1rem;margin-bottom:2rem}.about-section-heading>span{font-size:.63rem;color:var(--accent,#b34d38)}.about-section-heading h2{font-size:.9rem;font-weight:500;margin:0}.background-entry{margin-bottom:1.7rem}.entry-date{font-size:.63rem;letter-spacing:.03em;color:var(--muted,#73736a);margin:0 0 .6rem}.entry-date>span{font-size:.55rem;margin-left:.5rem;border:1px solid var(--line,#deddd5);padding:.15rem .3rem;border-radius:2px}.background-entry h3{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:1.6rem;font-weight:400;line-height:1.2;letter-spacing:-.02em;margin:0 0 .5rem}.background-entry>p:last-child{font-size:.79rem;color:var(--muted,#73736a);line-height:1.8;margin:0}.small-link{display:inline-block;font-size:.7rem;color:var(--muted,#73736a);text-decoration:none;margin-top:.3rem}.small-link:hover{color:var(--accent,#b34d38)}.interest-list{list-style:none;padding:0;margin:0}.interest-list li{display:flex;gap:1.15rem;border-bottom:1px solid var(--line,#deddd5);padding:1rem 0}.interest-list li:first-child{padding-top:0}.interest-list li>span{font-size:.6rem;color:var(--accent,#b34d38);padding-top:.3rem}.interest-list h3{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:1.4rem;font-weight:400;letter-spacing:-.02em;line-height:1.2;margin:0 0 .4rem}.interest-list p{font-size:.76rem;line-height:1.8;color:var(--muted,#73736a);margin:0}.beyond-research{border-top:1px solid var(--line,#deddd5);margin-top:4rem;padding-top:2.5rem;display:grid;grid-template-columns:1fr 1fr;gap:0 6rem}.beyond-research>.eyebrow{grid-column:1/-1;margin:0 0 1.5rem}.beyond-research h2{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:2.5rem;line-height:1.1;font-weight:400;letter-spacing:-.035em;margin:0}.beyond-research>div>p{font-size:.87rem;line-height:1.9;color:var(--muted,#73736a);margin:0 0 1.2rem}.beyond-research a{font-size:.73rem;color:var(--accent,#b34d38);text-decoration:none}.beyond-research a>span{padding-left:.4rem}.contact-section{margin-top:5rem;padding:3rem;background:#efeee7;display:grid;grid-template-columns:1.1fr 1fr;gap:4rem;scroll-margin-top:7rem}.contact-section .eyebrow{margin:0 0 1.4rem}.contact-section h2{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-weight:400;font-size:2.8rem;line-height:1.05;letter-spacing:-.035em;margin:0 0 1.3rem}.contact-section>div>p:last-child{font-size:.82rem;color:var(--muted,#73736a);line-height:1.85;max-width:340px;margin:0}.contact-links{align-self:center}.contact-links a{display:flex;align-items:baseline;justify-content:space-between;font-size:.75rem;color:inherit;text-decoration:none;padding:.95rem 0;border-bottom:1px solid #d8d6cc}.contact-links a:first-child{padding-top:0}.contact-links .email-link{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:1.4rem;letter-spacing:-.02em}.contact-links a:hover{color:var(--accent,#b34d38)}.contact-links a>span{color:var(--accent,#b34d38)}@media(max-width:1000px){.about-intro{grid-template-columns:260px 1fr;gap:3rem}.about-details,.beyond-research{gap:0 3rem}.about-photo img{height:330px}.contact-section{padding:2rem;gap:2rem}.contact-links .email-link{font-size:1.2rem}}@media(max-width:700px){.about-page{padding-bottom:4rem}.about-intro{grid-template-columns:1fr;gap:2rem;margin-top:2.5rem}.about-photo{max-width:300px}.about-photo img{height:330px}.about-copy .intro-line{font-size:1.7rem}.about-copy p{font-size:.9rem}.about-details{grid-template-columns:1fr;gap:2.5rem;margin-top:3.5rem;padding-top:2rem}.about-section-heading{margin-bottom:1.5rem}.background-entry h3{font-size:1.5rem}.beyond-research{grid-template-columns:1fr;gap:1rem;margin-top:3rem;padding-top:2rem}.beyond-research>.eyebrow{margin-bottom:.5rem}.beyond-research h2{font-size:2.2rem}.contact-section{grid-template-columns:1fr;gap:2.5rem;padding:1.6rem;margin-top:3rem}.contact-section h2{font-size:2.5rem}.contact-links .email-link{font-size:1.35rem}}
</style>
