---
import Layout from '../../layouts/Layout.astro';
import { profile } from '../../data/profile';
---
<Layout title="Projects" description="Open-source agent research and hardware prototypes by Qinyu Luo, including RepoAgent and the Intelligent Stethoscope." active="projects">
  <div class="container projects-page">
    <header class="page-heading projects-heading"><p class="eyebrow">Selected projects</p><h1 class="page-title">Ideas, made tangible.</h1><p class="page-intro">Open-source tools and language-model systems. A few things I’ve helped bring into the world.</p></header>

    <section class="project-list" aria-label="Selected projects">
      <article class="project project-featured" id="repoagent">
        <div class="repo-visual" aria-label="RepoAgent connects source code and documentation">
          <div class="visual-header"><span class="status-dot"></span><span>RepoAgent</span><span>code ↔ context</span></div>
          <div class="repo-diagram"><div class="repo-file"><span class="file-label">SOURCE</span><span class="file-name">repository/</span><div class="code-lines"><i></i><i></i><i></i><i></i></div></div><span class="diagram-link" aria-hidden="true">⇄</span><div class="repo-file doc-file"><span class="file-label">DOCUMENTATION</span><span class="file-name">understanding.md</span><div class="code-lines"><i></i><i></i><i></i><i></i></div></div></div>
          <div class="visual-footer"><span>Analyze</span><span>Understand</span><span>Keep in sync</span></div>
        </div>
        <div class="project-info"><div class="project-meta"><span>01 / Agent systems</span><span>EMNLP 2024 Demo</span></div><h2>RepoAgent<span>.</span></h2><p class="project-role">Co-first author</p><p class="project-description">A repository-level documentation assistant that uses language models to understand code, generate documentation, and keep it up to date as the codebase changes.</p><div class="project-tags"><span>LLM agents</span><span>Developer tools</span><span>Open source</span></div><div class="project-links"><a href="/research/repoagent/">Research overview <span aria-hidden="true">↗</span></a><a href="https://github.com/OpenBMB/RepoAgent" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href="/research/repoagent/#full-text">Paper <span aria-hidden="true">→</span></a></div></div>
      </article>

      <article class="project project-luotuo" id="luotuo">
        <div class="luotuo-visual" aria-hidden="true"><span class="luotuo-chinese" lang="zh">骆驼</span><span class="luotuo-caption">Luotuo · Open-source LLMs</span><div class="luotuo-rule"></div><span class="community-note">Built by a community.<br />Made to be shared.</span></div>
        <div class="project-info"><div class="project-meta"><span>02 / Open-source contribution</span><span>Community</span></div><h2>Luotuo<span>.</span></h2><p class="project-role">Contributor</p><p class="project-description">Contributions to the Luotuo open-source ecosystem, including Chinese language model and question-answering projects. A community effort to make language model research and tools more accessible.</p><div class="project-tags"><span>Chinese LLMs</span><span>Question answering</span><span>Open source</span></div><div class="project-links"><a href="https://github.com/LC1332/Luotuo-Chinese-LLM" target="_blank" rel="noopener noreferrer">Luotuo on GitHub <span aria-hidden="true">↗</span></a><a href="https://github.com/LC1332/Luotuo-QA" target="_blank" rel="noopener noreferrer">Luotuo-QA <span aria-hidden="true">↗</span></a></div></div>
      </article>
    </section>
    <section class="other-explorations" aria-label="Other explorations"><span>Other explorations</span><a href="/projects/stethoscope/">Intelligent Stethoscope <span aria-hidden="true">↗</span></a></section>
    <div class="project-contact"><p>Have a question, or an idea to explore together?</p><a href={`mailto:${profile.email}`}>Let’s talk <span aria-hidden="true">↗</span></a></div>
  </div>
</Layout>
<style>
  .other-explorations{border-top:1px solid var(--line);padding:1.3rem 0;display:flex;justify-content:space-between;gap:1rem;font-size:.75rem;color:var(--muted)}.other-explorations a{color:var(--accent)}
  .projects-page{padding-bottom:6rem}.projects-heading{max-width:820px}.project-list{margin-top:4rem}.project{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4rem;padding:3rem 0;border-top:1px solid var(--line,#deddd5);align-items:center}.project>*{min-width:0}.project:first-child{padding-top:0;border-top:0}.project-info{padding:.6rem 0}.project-meta{display:flex;justify-content:space-between;gap:1rem;font-size:.61rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted,#73736a)}.project-meta>span:first-child{color:var(--accent,#b34d38)}.project h2{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-weight:400;font-size:clamp(2.6rem,4vw,3.8rem);line-height:.97;letter-spacing:-.045em;margin:1.5rem 0 .7rem}.project h2>span{color:var(--accent,#b34d38)}.project-role{font-size:.72rem;color:var(--muted,#73736a);margin:0 0 1.2rem}.project-description{font-size:.88rem;line-height:1.9;color:var(--muted,#73736a);max-width:470px}.project-tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.3rem}.project-tags span{font-size:.62rem;border:1px solid var(--line,#deddd5);border-radius:999px;padding:.3rem .6rem}.project-links{display:flex;gap:1.3rem;flex-wrap:wrap;margin-top:1.8rem}.project-links a{font-size:.72rem;color:inherit;text-decoration:none}.project-links a:hover{color:var(--accent,#b34d38)}.project-links a span{padding-left:.2rem}.repo-visual{background:#eeece4;min-height:350px;display:flex;flex-direction:column;justify-content:space-between;padding:1.3rem;border:1px solid #e2e0d6}.visual-header{display:flex;align-items:center;gap:.5rem;font-size:.65rem;color:#6a695f}.visual-header>span:last-child{margin-left:auto;font-family:monospace;font-size:.62rem}.status-dot{width:6px;height:6px;border-radius:50%;background:#b34d38}.repo-diagram{display:flex;align-items:center;gap:1rem;justify-content:center;padding:2.5rem 0}.repo-file{background:#faf9f6;border:1px solid #d9d7cd;width:45%;min-width:0;flex:1 1 0;min-height:160px;padding:1rem;box-shadow:3px 4px 0 #e2dfd4}.file-label{display:block;font-size:.48rem;color:#8b887d;letter-spacing:.08em}.file-name{display:block;font-size:.66rem;letter-spacing:-.03em;font-family:monospace;margin-top:1rem;overflow-wrap:anywhere}.diagram-link{font-size:1.5rem;color:#b34d38}.code-lines{display:flex;flex-direction:column;gap:.45rem;margin-top:1.4rem}.code-lines i{height:3px;background:#d9d6c9;width:80%}.code-lines i:nth-child(2){width:55%;margin-left:10%}.code-lines i:nth-child(3){width:65%;margin-left:10%}.code-lines i:nth-child(4){width:35%}.doc-file .code-lines i{background:#d5aa9c}.visual-footer{display:flex;justify-content:space-between;font-size:.56rem;color:#827f74;text-transform:uppercase;letter-spacing:.06em;padding-top:1rem;border-top:1px solid #d9d7cd}.stethoscope-visual{display:block;position:relative;min-height:350px;background:#e6e3d8;overflow:hidden}.stethoscope-visual img{width:100%;height:350px;object-fit:cover;object-position:center;display:block;transition:transform .4s}.stethoscope-visual:hover img{transform:scale(1.025)}.image-caption{position:absolute;left:0;right:0;bottom:0;background:rgba(250,249,246,.94);padding:.95rem 1.1rem;display:flex;justify-content:space-between;align-items:center;color:#66645a;font-size:.6rem;letter-spacing:.05em;text-transform:uppercase}.image-caption>span{font-size:1rem;color:#b34d38}.luotuo-visual{min-height:350px;background:#e9ece6;padding:2rem;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#657160}.luotuo-chinese{font-family:serif;font-size:5rem;letter-spacing:.16em;line-height:1.1}.luotuo-caption{font-size:.6rem;letter-spacing:.1em;margin-top:1.2rem;text-transform:uppercase}.luotuo-rule{width:36px;height:1px;background:#9ca394;margin:1.5rem 0 1rem}.community-note{text-align:center;font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-style:italic;font-size:1.2rem;line-height:1.3}.project-contact{display:flex;align-items:baseline;justify-content:space-between;gap:2rem;border-top:1px solid var(--line,#deddd5);margin-top:1rem;padding-top:2rem}.project-contact p{color:var(--muted,#73736a);font-size:.9rem}.project-contact a{font-family:var(--font-serif,'Newsreader Variable',Georgia,serif);font-size:1.7rem;text-decoration:none;color:var(--accent,#b34d38);white-space:nowrap}.project-contact a>span{padding-left:.5rem}@media(max-width:1000px){.project{gap:2rem}.project-meta{flex-direction:column;gap:.4rem}.repo-visual{padding:1rem}.repo-diagram{gap:.6rem}.repo-file{padding:.7rem}.file-name{font-size:.58rem}}@media(max-width:700px){.projects-page{padding-bottom:4rem}.project-list{margin-top:2.5rem}.project{grid-template-columns:minmax(0,1fr);gap:1.5rem;padding:2.3rem 0}.project-meta{flex-direction:row;flex-wrap:wrap;gap:.5rem}.project h2{font-size:2.8rem;margin-top:1.1rem}.repo-visual,.luotuo-visual{min-height:300px}.repo-file{padding:1rem}.file-name{font-size:.68rem}.stethoscope-visual{min-height:280px}.stethoscope-visual img{height:300px}.project-description{max-width:none}.project-contact{align-items:start;flex-direction:column;gap:.7rem}.project-contact p{margin-bottom:0}.project-contact a{font-size:1.6rem}}
  @media(max-width:400px){.repo-file{padding:.6rem}.file-name{font-size:clamp(.48rem,2.4vw,.68rem)}.project h2{font-size:clamp(2.2rem,10vw,2.8rem);overflow-wrap:anywhere}}
</style>
